{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "__BRAIN__/bin/session-start.sh", "timeout": 30 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "__BRAIN__/bin/session-end.sh", "timeout": 30 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "__BRAIN__/bin/inject-memory.py", "timeout": 10 } ] }
    ]
  },
  "autoMemoryDirectory": "__BRAIN__/memory"
}
